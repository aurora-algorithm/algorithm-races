     "version": ["{env:QJS|qjs}", "--help"], "mt": false, "kernels": ["sort-int", "sort-str", "quicksort", "mergesort", "heapsort", "radixsort", "binary-trees", "nbody", "mandelbrot", "fannkuch", "spectral-norm", "regex-log", "hashmap", "sieve", "matmul", "json", "bfs-grid", "dijkstra", "kruskal", "bst", "trie", "lru", "edit-distance", "knapsack", "lis", "kmp", "str-find", "fib", "nqueens", "binary-search", "sudoku", "bloom", "hyperloglog", "skiplist", "cycle", "palindrome", "bwt", "aho-corasick", "pi-digits", "life", "huffman", "window-max", "rain-water", "collatz"]},
    {"id": "txiki", "lang": "jsengines", "label": "txiki.js (QuickJS-ng + libuv)", "run": ["{env:TJS|tjs}", "run", "dist/tjs.js"],
     "version": ["{env:TJS|tjs}", "--version"], "mt": false, "kernels": ["sort-int", "sort-str", "quicksort", "mergesort", "heapsort", "radixsort", "binary-trees", "nbody", "mandelbrot", "fannkuch", "spectral-norm", "regex-log", "hashmap", "sieve", "matmul", "json", "bfs-grid", "dijkstra", "kruskal", "bst", "trie", "lru", "edit-distance", "knapsack", "lis", "kmp", "str-find", "fib", "nqueens", "binary-search", "sudoku", "bloom", "hyperloglog", "skiplist", "cycle", "palindrome", "bwt", "aho-corasick", "pi-digits", "life", "huffman", "window-max", "rain-water", "collatz"]},
