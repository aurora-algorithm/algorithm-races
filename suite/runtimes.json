{
  "langs": {
    "c": {"cwd": "c", "build": "./fetch_deps.sh", "lint": ["./build.sh lint"]},
    "cpp": {"cwd": "cpp", "build": "./deps.sh", "lint": ["uvx clang-format==23.1.5 --dry-run --Werror src/*.cpp src/*.hpp", "./build.sh warnings"]},
    "rust": {
      "cwd": "rust",
      "build": "cargo build --release",
      "lint": ["cargo fmt --check", "cargo clippy --release -- -D warnings"]
    },
    "go": {
      "cwd": "go",
      "build": "go build -o bin/kernels{exe} .",
      "lint": ["test -z \"$(gofmt -l .)\"", "go vet ./...", "go run honnef.co/go/tools/cmd/staticcheck@latest ./..."]
    },
    "csharp": {
      "cwd": "csharp",
      "build": "dotnet publish -c Release -o bin/jit",
      "lint": ["dotnet format --verify-no-changes", "dotnet build -c Release -warnaserror"]
    },
    "java": {
      "cwd": "java",
      "build": "mvn -q -B package",
      "lint": ["mvn -q -B fmt:check"]
    },
    "js": {
      "cwd": "js",
      "build": "npm ci --no-audit --no-fund",
      "lint": ["npx --yes @biomejs/biome@2.6.7 check ."]
    },
    "jsengines": {
      "cwd": "engines",
      "build": "npm ci --no-audit --no-fund && npm run build",
      "lint": ["npx --yes @biomejs/biome@2.6.7 check ."]
    },
    "wasm": {
      "cwd": "wasm",
      "build": "cargo build --release --locked --target wasm32-wasip1",
      "lint": ["cargo fmt --check", "cargo clippy --release --locked --target wasm32-wasip1 -- -D warnings"]
    },
    "python": {
      "cwd": "python",
      "build": "",
      "lint": ["uvx ruff check ..", "uvx ruff format --check .."]
    },
    "pylibs": {
      "cwd": "python",
      "build": "",
      "lint": []
    },
    "goose": {
      "cwd": "goose",
      "build": "",
      "lint": ["\"${GOOSE:-goose}\" format --check .", "test -z \"$(\"${GOOSE:-goose}\" check main.goose 2>&1)\""]
    }
  },
  "runtimes": [
    {"id": "rust", "lang": "rust", "label": "Rust", "run": ["target/release/kernels{exe}"],
     "version": ["rustc", "-V"], "mt": true},
    {"id": "wasm-wasmtime", "lang": "wasm", "label": "Rust -> Wasm on Wasmtime (Cranelift)",
     "run": ["{env:WASMTIME|wasmtime}", "run", "--dir", "../data::/data", "--env", "KERNELS_GUEST_DATA=/data", "target/wasm32-wasip1/release/kernels.wasm"],
     "version": ["{env:WASMTIME|wasmtime}", "--version"], "mt": false, "skip_groups": ["work", "mt"]},
    {"id": "wasm-wasmedge", "lang": "wasm", "label": "Rust -> Wasm on WasmEdge (LLVM AOT)",
     "run": ["{env:WASMEDGE|wasmedge}", "--run-mode", "aot", "--dir", "/data:../data", "--env", "KERNELS_GUEST_DATA=/data", "target/kernels-aot.wasm"],
     "build": "test target/kernels-aot.wasm -nt target/wasm32-wasip1/release/kernels.wasm || \"${WASMEDGE:-wasmedge}\" compile target/wasm32-wasip1/release/kernels.wasm target/kernels-aot.wasm",
     "version": ["{env:WASMEDGE|wasmedge}", "--version"], "mt": false, "skip_groups": ["work", "mt"]},
    {"id": "wasm-wasmer", "lang": "wasm", "label": "Rust -> Wasm on Wasmer (Cranelift)",
     "run": ["{env:WASMER|wasmer}", "run", "--volume", "../data:/data", "--env", "KERNELS_GUEST_DATA=/data", "target/wasm32-wasip1/release/kernels.wasm", "--"],
     "version": ["{env:WASMER|wasmer}", "-vV"], "mt": false, "skip_groups": ["work", "mt"]},
    {"id": "wasm-wasmer-llvm", "lang": "wasm", "label": "Rust -> Wasm on Wasmer (LLVM)",
     "run": ["{env:WASMER|wasmer}", "run", "--llvm", "--volume", "../data:/data", "--env", "KERNELS_GUEST_DATA=/data", "target/wasm32-wasip1/release/kernels.wasm", "--"],
     "version": ["{env:WASMER|wasmer}", "-vV"], "mt": false, "skip_groups": ["work", "mt"]},
    {"id": "go", "lang": "go", "label": "Go", "run": ["bin/kernels{exe}"], "version": ["go", "version"], "mt": true},
    {"id": "go-typedheap", "lang": "go", "label": "Go, typed binary heap (no container/heap)", "run": ["bin/kernels{exe}"], "env": {"KERNELS_DIJKSTRA_HEAP": "typed"}, "version": ["go", "version"], "mt": false, "kernels": ["dijkstra"], "opt_in": true},
    {"id": "go-typedheap4", "lang": "go", "label": "Go, typed 4-ary heap (no container/heap)", "run": ["bin/kernels{exe}"], "env": {"KERNELS_DIJKSTRA_HEAP": "typed4"}, "version": ["go", "version"], "mt": false, "kernels": ["dijkstra"], "opt_in": true},
    {"id": "go-swapheap", "lang": "go", "label": "Go, generic port of container/heap (same swaps, no interface)", "run": ["bin/kernels{exe}"], "env": {"KERNELS_DIJKSTRA_HEAP": "typedswap"}, "version": ["go", "version"], "mt": false, "kernels": ["dijkstra"], "opt_in": true},
    {"id": "go-heap32", "lang": "go", "label": "Go, container/heap, int32 node ids (C#'s types)", "run": ["bin/kernels{exe}"], "env": {"KERNELS_DIJKSTRA_HEAP": "container32"}, "version": ["go", "version"], "mt": false, "kernels": ["dijkstra"], "opt_in": true},
    {"id": "go-typedheap32", "lang": "go", "label": "Go, typed binary heap, int32 node ids (C#'s types)", "run": ["bin/kernels{exe}"], "env": {"KERNELS_DIJKSTRA_HEAP": "typed32"}, "version": ["go", "version"], "mt": false, "kernels": ["dijkstra"], "opt_in": true},
    {"id": "go-tinygo", "lang": "go", "label": "TinyGo", "run": ["bin/kernels-tinygo{exe}"],
     "build": "\"{env:TINYGO|tinygo}\" build -tags noasm -o bin/kernels-tinygo{exe} .",
     "version": ["{env:TINYGO|tinygo}", "version"], "mt": true, "skip_groups": ["mt"],
     "skip_why": {"mt": "on Windows TinyGo 0.44 uses its tasks scheduler (tinygo.unicore): every goroutine runs on one OS thread, so T = 2..8 would time one core; skipped on every OS so the rows match the i7"}},
    {"id": "go-nogreenteagc", "lang": "go", "label": "Go, Green Tea GC off", "run": ["bin/kernels-nogreenteagc{exe}"],
     "build": "GOEXPERIMENT=nogreenteagc go build -o bin/kernels-nogreenteagc{exe} .",
     "version": ["go", "version"], "mt": true},
    {"id": "cs-jit", "lang": "csharp", "label": "C# .NET JIT", "run": ["bin/jit/Kernels{exe}"],
     "version": ["dotnet", "--list-runtimes"], "mt": true},
    {"id": "cs-aot", "lang": "csharp", "label": "C# NativeAOT", "run": ["bin/aot/Kernels{exe}"],
     "build": "dotnet publish -c Release -r {rid} -p:PublishAot=true -o bin/aot",
     "version": ["dotnet", "--list-sdks"], "mt": true},
    {"id": "cs-r2r", "lang": "csharp", "label": "C# .NET ReadyToRun", "run": ["bin/r2r/Kernels{exe}"],
     "build": "dotnet publish -c Release -r {rid} -p:PublishReadyToRun=true --self-contained false -o bin/r2r",
     "version": ["dotnet", "--list-runtimes"], "mt": true},
    {"id": "cs-jit-pgo-off", "lang": "csharp", "label": "C# .NET JIT, dynamic PGO off", "run": ["bin/jit/Kernels{exe}"],
     "env": {"DOTNET_TieredPGO": "0"}, "version": ["dotnet", "--list-runtimes"], "mt": true},
    {"id": "cs-jit-tc-off", "lang": "csharp", "label": "C# .NET JIT, tiered compilation off", "run": ["bin/jit/Kernels{exe}"],
     "env": {"DOTNET_TieredCompilation": "0"}, "version": ["dotnet", "--list-runtimes"], "mt": true},
    {"id": "java", "lang": "java", "label": "Java HotSpot", "run": ["{env:JAVA_HOME|/opt/homebrew/opt/openjdk}/bin/java{exe}", "-jar", "target/kernels.jar"],
     "version": ["{env:JAVA_HOME|/opt/homebrew/opt/openjdk}/bin/java{exe}", "-version"], "mt": true},
    {"id": "java-primheap", "lang": "java", "label": "Java HotSpot, primitive-array heap", "run": ["{env:JAVA_HOME|/opt/homebrew/opt/openjdk}/bin/java{exe}", "-jar", "target/kernels.jar"], "env": {"KERNELS_DIJKSTRA_HEAP": "primitive"}, "version": ["{env:JAVA_HOME|/opt/homebrew/opt/openjdk}/bin/java{exe}", "-version"], "mt": false, "kernels": ["dijkstra"], "opt_in": true},
    {"id": "java-graal", "lang": "java", "label": "Java GraalVM JIT", "run": ["{env:GRAALVM_HOME|}/bin/java{exe}", "-jar", "target/kernels.jar"], "needs": ["GRAALVM_HOME"],
     "version": ["{env:GRAALVM_HOME|}/bin/java{exe}", "-version"], "mt": true},
    {"id": "java-native", "lang": "java", "label": "Java native-image", "run": ["target/kernels-native{exe}"],
     "build": "./build_native.sh", "needs": ["GRAALVM_HOME"],
     "version": ["{env:GRAALVM_HOME|}/bin/native-image{cmd}", "--version"], "mt": true, "skip_groups": ["work"]},
    {"id": "java-openj9", "lang": "java", "label": "Java OpenJ9 (IBM Semeru)", "run": ["{env:SEMERU_HOME|}/bin/java{exe}", "-jar", "target/kernels.jar"], "needs": ["SEMERU_HOME"],
     "version": ["{env:SEMERU_HOME|}/bin/java{exe}", "-version"], "mt": true},
    {"id": "java-corretto", "lang": "java", "label": "Java HotSpot (Amazon Corretto)", "run": ["{env:CORRETTO_HOME|}/bin/java{exe}", "-jar", "target/kernels.jar"], "needs": ["CORRETTO_HOME"],
     "version": ["{env:CORRETTO_HOME|}/bin/java{exe}", "-version"], "mt": true},
    {"id": "java-zulu", "lang": "java", "label": "Java HotSpot (Azul Zulu)", "run": ["{env:ZULU_HOME|}/bin/java{exe}", "-jar", "target/kernels.jar"], "needs": ["ZULU_HOME"],
     "version": ["{env:ZULU_HOME|}/bin/java{exe}", "-version"], "mt": true},
    {"id": "java-microsoft", "lang": "java", "label": "Java HotSpot (Microsoft Build of OpenJDK)", "run": ["{env:MSJDK_HOME|}/bin/java{exe}", "-jar", "target/kernels.jar"], "needs": ["MSJDK_HOME"],
     "version": ["{env:MSJDK_HOME|}/bin/java{exe}", "-version"], "mt": true},
    {"id": "java-liberica", "lang": "java", "label": "Java HotSpot (BellSoft Liberica)", "run": ["{env:LIBERICA_HOME|}/bin/java{exe}", "-jar", "target/kernels.jar"], "needs": ["LIBERICA_HOME"],
     "version": ["{env:LIBERICA_HOME|}/bin/java{exe}", "-version"], "mt": true},
    {"id": "java-oracle", "lang": "java", "label": "Java HotSpot (Oracle JDK)", "run": ["{env:ORACLE_JDK_HOME|}/bin/java{exe}", "-jar", "target/kernels.jar"], "needs": ["ORACLE_JDK_HOME"],
     "version": ["{env:ORACLE_JDK_HOME|}/bin/java{exe}", "-version"], "mt": true},
    {"id": "node", "lang": "js", "label": "Node", "run": ["node", "main.mjs"], "version": ["node", "--version"], "mt": true},
    {"id": "node-hllclz", "lang": "js", "label": "Node, Math.clz32(h << 14) without >>> 0", "run": ["node", "main.mjs"], "env": {"KERNELS_HLL": "clz"}, "version": ["node", "--version"], "mt": false, "kernels": ["hyperloglog"], "opt_in": true},
    {"id": "bun", "lang": "js", "label": "Bun", "run": ["bun", "main.mjs"], "version": ["bun", "--version"], "mt": true},
    {"id": "deno", "lang": "js", "label": "Deno", "run": ["deno", "run", "-A", "main.mjs"], "version": ["deno", "--version"], "mt": true},
    {"id": "deno-hllclz", "lang": "js", "label": "Deno, Math.clz32(h << 14) without >>> 0", "run": ["deno", "run", "-A", "main.mjs"], "env": {"KERNELS_HLL": "clz"}, "version": ["deno", "--version"], "mt": false, "kernels": ["hyperloglog"], "opt_in": true},
    {"id": "graalnode", "lang": "js", "label": "GraalNode (Node 24 on GraalJS)", "run": ["{env:GRAALNODE_HOME|}/bin/node{exe}", "main.mjs"], "needs": ["GRAALNODE_HOME"],
     "version": ["{env:GRAALNODE_HOME|}/bin/node{exe}", "-p", "process.version + ' GraalVM ' + Graal.versionGraalVM"], "mt": true},
    {"id": "node-portable", "lang": "jsengines", "label": "Node (portable bundle, control)", "run": ["node", "dist/node.mjs"],
     "version": ["node", "--version"], "mt": false, "kernels": ["sort-int", "sort-str", "quicksort", "mergesort", "heapsort", "radixsort", "binary-trees", "nbody", "mandelbrot", "fannkuch", "spectral-norm", "regex-log", "hashmap", "sha256", "sieve", "matmul", "json", "bfs-grid", "dijkstra", "kruskal", "bst", "trie", "lru", "edit-distance", "knapsack", "lis", "kmp", "str-find", "fib", "nqueens", "binary-search", "sudoku", "bloom", "hyperloglog", "skiplist", "cycle", "palindrome", "bwt", "aho-corasick", "pi-digits", "life", "huffman", "window-max", "rain-water", "collatz"]},
    {"id": "llrt", "lang": "jsengines", "label": "LLRT (QuickJS, AWS)", "run": ["{env:LLRT|llrt}", "dist/llrt.mjs"],
