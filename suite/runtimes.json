    {"id": "py313", "lang": "python", "label": "CPython 3.13", "run": ["{env:PY313|python3.13}", "main.py"],
     "version": ["{env:PY313|python3.13}", "-VV"], "mt": false, "skip_groups": ["work"]},
    {"id": "py314", "lang": "python", "label": "CPython 3.14", "run": ["{env:PY314|python3.14}", "main.py"],
     "version": ["{env:PY314|python3.14}", "-VV"], "mt": true, "skip_groups": ["work"]},
    {"id": "py314t", "lang": "python", "label": "CPython 3.14t (free-threaded)", "run": ["{env:PY314T|python3.14t}", "main.py"],
     "version": ["{env:PY314T|python3.14t}", "-VV"], "mt": true, "skip_groups": ["work"]},
    {"id": "pypy", "lang": "python", "label": "PyPy 3.11", "run": ["{env:PYPY311|pypy3.11}", "main.py"],
     "version": ["{env:PYPY311|pypy3.11}", "-VV"], "mt": false, "skip_groups": ["work"]},
    {"id": "py-numpy", "lang": "python", "label": "CPython 3.14 + NumPy (C library)",
     "run": ["{env:PYNUMPY|../.venv-numpy/bin/python}", "main.py", "--numpy"],
     "run_windows": ["{env:PYNUMPY|../.venv-numpy/Scripts/python.exe}", "main.py", "--numpy"],
     "build": "test -x ../.venv-numpy/bin/python || test -x ../.venv-numpy/Scripts/python.exe || (uv venv -q -p \"${PY314:-3.14}\" ../.venv-numpy && uv pip install -q -p ../.venv-numpy numpy)",
