     "version_windows": ["{env:PYNUMPY|../.venv-numpy/Scripts/python.exe}", "-c", "import sys, numpy; print(sys.version, 'numpy', numpy.__version__); numpy.show_config()"],
     "env": {"OPENBLAS_NUM_THREADS": "1", "OMP_NUM_THREADS": "1", "MKL_NUM_THREADS": "1", "VECLIB_MAXIMUM_THREADS": "1"},
     "kernels": ["sort-int", "matmul"], "mt": false},
